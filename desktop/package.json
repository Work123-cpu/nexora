{
  "name": "nexora-desktop",
  "version": "1.0.0",
  "description": "Nexora — Windows desktop launcher (Electron shell around the existing web app)",
  "author": "Nexora",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.nexora.desktop",
    "productName": "Nexora",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "main.js",
      "preload.js",
      "setup.html",
      "splash.html",
      "build/**/*"
    ],
    "extraResources": [
      { "from": "../frontend/dist", "to": "frontend-dist" },
      { "from": "../.tools", "to": "tools" },
      { "from": "../backend", "to": "backend", "filter": ["**/*", "!target", "!target/**"] },
      { "from": "../ai-service", "to": "ai-service", "filter": ["**/*", "!.venv", "!.venv/**", "!__pycache__", "!**/__pycache__/**", "!**/*.pyc", "!.env"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
