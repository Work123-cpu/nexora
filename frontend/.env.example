# Base URL for the Spring Boot REST API (backend/) — the app's real data source by default
VITE_API_BASE_URL=http://localhost:8081/api

# Base URL for the FastAPI AI service (ai-service/), used only when VITE_USE_MOCK_AI=false
VITE_AI_SERVICE_URL=http://localhost:8000

# Set to "false" once you've added your own GROQ_API_KEY to ai-service/.env
VITE_USE_MOCK_AI=true

# Set to "false" to route demand forecasting through httpForecastAdapter -> ai-service's
# XGBoost/Random Forest models instead of the naive avg-usage projection. Independent of
# VITE_USE_MOCK_AI since forecast model readiness and Groq availability are unrelated.
VITE_USE_MOCK_FORECAST=true

