# Groq API key — get one at https://console.groq.com
# Left unset, the service runs in degraded mode: endpoints return a clear
# "AI provider not configured" response instead of failing, so the frontend
# never crashes while this key is absent during development.
GROQ_API_KEY=

# Model used for all Groq chat completions
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call this service (the frontend dev server)
ALLOWED_ORIGINS=http://localhost:5173

# Host/port for uvicorn when run via `python -m app.main`
HOST=0.0.0.0
PORT=8000

LOG_LEVEL=INFO
